# Secrets documentation:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
#
# Formal schema:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format
version: "2.0"
# Do not commit a filled values-secret.yaml to git.

secrets:
  - name: ignition-admin
    vaultPrefixes:
      - global
    fields:
      - name: gateway-admin-password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  # API token created in the control-room Gateway (X-Ignition-API-Token).
  # The mock-devices ExternalSecret projects this field into
  # secret/control-room-ignition-api-token in namespace ignition.
  - name: ignition-api
    vaultPrefixes:
      - global
    fields:
      - name: token
        onMissingValue: prompt
        vaultPolicy: validatedPatternDefaultPolicy

  # Used only if you uncomment the rhbk-cert application on a cluster
  # that does not already run Red Hat Build of Keycloak.
  - name: keycloak-initial-admin
    vaultPrefixes:
      - global
    fields:
      - name: username
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy
      - name: password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  - name: keycloak-db-secret
    vaultPrefixes:
      - global
    fields:
      - name: username
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy
      - name: password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  # URL of the RHEL 9 KVM guest image used by OpenShift Virtualization DataVolumes.
  # Paste a pullable HTTPS URL from the Red Hat Customer Portal (or a mirror).
  - name: rhel-guest-image
    vaultPrefixes:
      - global
    fields:
      - name: url
        onMissingValue: prompt
        vaultPolicy: validatedPatternDefaultPolicy
